# Registry mapping only. The token lives in the user-level npmrc:
#   pnpm config set //npm.pkg.github.com/:_authToken <PAT with read:packages>
# pnpm 11 does not expand ${ENV_VAR} in a repo .npmrc, so a token written here
# would silently fail authentication.
@colosseumcoinckr:registry=https://npm.pkg.github.com
